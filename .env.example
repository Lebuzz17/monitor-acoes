# API Groq (https://console.groq.com)
GROQ_API_KEY=sua_groq_api_key_aqui

# Telegram Bot (obtenha com @BotFather)
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui

# Chat ID do destinatario (use @userinfobot para descobrir)
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Alpha Vantage - noticias com relevance_score (free: 25 req/dia)
# Obtenha em: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=sua_alpha_vantage_key_aqui

# NewsAPI - camada 1 de extracao de conteudo completo (opcional)
# Obtenha em: https://newsapi.org/register
NEWS_API_KEY=sua_news_api_key_aqui

# Firecrawl - camada 3 de extracao (paginas com JS/paywall, opcional)
# Obtenha em: https://www.firecrawl.dev/
FIRECRAWL_KEY=sua_firecrawl_key_aqui
